Type: Input
%-------------------------------------------------------------------------%
notebookDir = NotebookDirectory[];
modulesDir = FileNameJoin[{notebookDir, "Modules", "Services"}];
viewsDir = FileNameJoin[{notebookDir, "Modules", "Views"}];

{fileLoader, sorter} = Get[FileNameJoin[{modulesDir, "Filenames", "Filenames.wl"}]];
fileConvertLoader = Get[FileNameJoin[{modulesDir, "Convert", "Filenames.wl"}]];
fileImporter = Get[FileNameJoin[{modulesDir, "Fileimport", "Fileimport.wl"}]];
fileConvertImporter = Get[FileNameJoin[{modulesDir, "Convert", "Fileimport.wl"}]];
phaseUnwrap = Get[FileNameJoin[{modulesDir, "Phaseunwrap", "Phaseunwrap.wl"}]];
materialParams = Get[FileNameJoin[{modulesDir, "Material", "Material.wl"}]];
fittingLoader = Get[FileNameJoin[{modulesDir, "Fitting", "Fitting.wl"}]];

windowContainer = ImportComponent[FileNameJoin[{notebookDir, "Common", "Container.wlx"}]];
resultsTable = ImportComponent[FileNameJoin[{viewsDir, "ResultsTable", "ResultsTable.wlx"}]];
{summary, views, exporter} = Get[FileNameJoin[{viewsDir, "Summary", "Summary.wl"}]];

