.md
## Landing Window

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## Landing Window

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
.wlx

With[{
  UId = CreateUUID[],
  event = CreateUUID[],
  notebook = EvaluationNotebook[]
}, Module[{garbageCollector},

        garbageCollector := With[{win = CurrentWindow[]},
           EventHandler[win, {"Closed" -> Function[Null,
              ClearAll[session];
           ]}];
           
           ClearAll[garbageCollector];
        ];

EventHandler[event, {
  "Upload" -> Function[Null,
    With[{promise = SystemDialogInputAsync["OpenList", {Null, {"Tabular Formats" -> {"*.csv", "*.tsv"}, "Plain ASCII" -> {"*.dat"}}}]},

      Then[promise, Function[files,
        If[StringQ[files[[1]]],
          With[{p = mainPipeline[notebook, files]},
            Then[p, Function[result,
              CellPrint[resultsTable[result, 
              <|
                "View" -> Function[files,
                  garbageCollector;
                  CellPrint[summary[sortFiles @ files], "Display" -> "wlx", "Target" -> _, "Notebook" -> notebook, ImageSize -> {1.3 526 1.5, 651}];
                ], 
                
                "Export" -> Function[files,
                  garbageCollector;
                  exporter["Alpha", files]
                ]
              |>
            ], "Display" -> "wlx", "Target" -> _, "Notebook" -> notebook, ImageSize -> {1.3 526 1.5, 651}];
            ]]
          ]
        ]
      ]]; 
    ]
  ],

  "Explore" -> Function[Null,
    Then[SystemDialogInputAsync["Directory"], Function[path,
      If[StringQ[path], openFolder[notebook, path]];
    ]];
    
  ],

  _ -> (FrontSubmit[Alert["Not implemented"]]&)
}];

<div class="ml-auto mr-auto mt-auto mb-auto px-3 py-2">
  <div class="pb-4">
    <h4 class="text-gray-700 uppercase text-md">Terakitchen</h4>
    <small class="text-gray-700">Start from here</small>
  </div>
<div class="ml-auto mr-auto mt-auto mb-auto flex flex-row gap-x-2">
  <button id="explore-{UId}" title="Browse" class="flex items-center gap-x-1 bg-gray-50 rounded border p-1 px-2">
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect width="24" height="24"/>
<path d="M4 9V6.47214C4 6.16165 4.07229 5.85542 4.21115 5.57771L5 4H10L11 6H21C21.5523 6 22 6.44772 22 7V9V18C22 19.1046 21.1046 20 20 20H18" stroke="#000000" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M17.2362 9H2.30925C1.64988 9 1.17099 9.62698 1.34449 10.2631L3.59806 18.5262C3.83537 19.3964 4.62569 20 5.52759 20H19.6908C20.3501 20 20.829 19.373 20.6555 18.7369L18.201 9.73688C18.0823 9.30182 17.6872 9 17.2362 9Z" stroke="#000000"/>
</svg>
    <span class="text-xs ml-1">Browse</span>
  </button>
</div>

  <WebUIEventListener Id={StringJoin["explore-", UId]} Event={event} Pattern={"Explore"} />
  
</div>

]]

