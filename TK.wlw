Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
## Supplimentary pipleline
Used for loading folders

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## Supplimentary pipleline
Used for loading folders

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
convertAllToFiles[File[f_]] := f;
convertAllToFiles[any_] := FileNameTake /@ (any["Tags"]["Filename"]);
convertAllToFiles[files_List, path_String] := Map[FileNameJoin[{path, #}]&, convertAllToFiles /@ files // Flatten];

garbageTemp = {};


openFolder[notebook_, path_String] := With[{promise = Promise[]}, Module[{session = {}, garbageCollector},

      AppendTo[garbageTemp, Hold[session]];
      ClearAttributes[session, Temporary];
      
      If[FileExistsQ[FileNameJoin[{path, ".TK_Store"}]],
        session = Import[FileNameJoin[{path, ".TK_Store"}], "WXF"];
      ];

      session = With[{files = FileNames["*.csv" | "*.dat" | "*.tsv", path]},
        Join[session, File /@ Select[FileNameTake /@ files, Function[name,
          With[{filename = name},
            With[{checks = Table[
              {
                filename === i["Tags"]["Filename"][[1]],
                filename === i["Tags"]["Filename"][[2]]
              }
            , {i, session}] // Flatten},
              If[Length[checks] == 0,
                True,
                (Or @@ checks) // Not
              ]
            ]
          ]
        ]] ]
      ];


      CellPrint[resultsTable[sortFiles[session], <|"Fitting" -> Function[files, With[{win = CurrentWindow[]},
            garbageCollector;

            If[AnyTrue[files, MatchQ[#, _File]&],
              FrontSubmit[Alert["Not possible to fit unprocessed files"]];
              Return[];
            ];

            If[Length[files] > 1,
              FrontSubmit[Alert["Select only one item"]];
              Return[];
            ];
            
            Then[fittingPipeline[notebook, path, sortFiles @ files], Function[result, Module[{},
              If[result === False, Return[]];
             
              With[{toRemove = Flatten[Map[FileNameTake, #["Tags"]["Filename"]] &/@ result]},
                With[{purged = Select[Select[session, (!MatchQ[#, _File])&], Function[item, 
                  !MemberQ[toRemove, item["Tags"]["Filename"][[1]]]
                ]]},
                  
                  Export[FileNameJoin[{path, ".TK_Store"}], Join[purged, result], "WXF"];
      
                  openFolder[notebook, path];
                  
                  WebUIClose[win["Socket"]];
                  
                ]
              ]];
            ]];
          ]], "View" -> Function[files,

          garbageCollector;
          
          If[AnyTrue[files, MatchQ[#, _File]&],
            FrontSubmit[Alert["Not possible to view unprocessed files"]];
            Return[];
          ];
          
          CellPrint[summary[sortFiles @ files], "Display"->"wlx", "Target"->_, "Notebook"->notebook, ImageSize->{1.3 526 1.5, 651}];
        
        ], "Export" -> Function[files,

          garbageCollector;

          If[AnyTrue[files, MatchQ[#, _File]&],
            FrontSubmit[Alert["Not possible to export unprocessed"]];
            Return[];
          ];
          
          exporter["Alpha", files]
          
        ],

        "Convert" -> Function[files, With[{win = CurrentWindow[]},
            garbageCollector;
            
            Then[convertPipeline[notebook, convertAllToFiles[files, path]], Function[result,
              
              With[{table = Map[Function[file,
                {
                  {file["+"], "P"<>file["Name"]},
                  {file["-"], "M"<>file["Name"]}
                }
              ], result]},

                Then[SystemDialogInputAsync["Directory", "Window"->win], Function[dir,
                    If[StringQ[dir],
                      Map[Function[t,
                        Export[ FileNameJoin[{dir, t[[1, 2]]}], t[[1, 1]] ];
                        Export[ FileNameJoin[{dir, t[[2, 2]]}], t[[2, 1]] ];
                      ], table];

                      openFolder[notebook, dir];
                    ]
                ]];
                
              ]
            ]];
          ]],

          "Process" -> Function[files, With[{win = CurrentWindow[]},
            garbageCollector;
            
            Then[mainPipeline[notebook, convertAllToFiles[files, path]], Function[result,
    
              With[{toRemove = Flatten[Map[FileNameTake, #["Tags"]["Filename"]] &/@ result]},
                With[{purged = Select[Select[session, (!MatchQ[#, _File])&], Function[item, 
                  !MemberQ[toRemove, item["Tags"]["Filename"][[1]]]
                ]]},
                  
                  Export[FileNameJoin[{path, ".TK_Store"}], Join[purged, result], "WXF"];
      
                  openFolder[notebook, path];
                  
                  WebUIClose[win["Socket"]];
                  
                ]
              ];
            ]];
          ]]
        
        |>, "AllowProcessing"->True], "Display"->"wlx", "Target"->_, "Notebook"->notebook, ImageSize->{1.3 526 1.5, 651}];

        garbageCollector := With[{win = CurrentWindow[]},
           EventHandler[win, {"Closed" -> Function[Null,
              ClearAll[session];
           ]}];
           
           ClearAll[garbageCollector];
        ];
      
]]

