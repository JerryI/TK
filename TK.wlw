   <|"Data" -> "takeFileName[f_] := \
takeFileName[File[ToLowerCase[f[\"Tags\"][\"Filename\"][[1]]]]]\ntakeFileName\
[File[f_]] := StringReplace[ToLowerCase[f], {\n  \"_reference_\" -> \"_\", \
\"_reference\" -> \"\", \n  \"_ref\" -> \"\", \"ref_\" -> \"\", \n  \"_hole\" \
-> \"\", \"hole_\" -> \"\", \n  \"_sample\" -> \"\", \"sample\" -> \"\",\n  \
\"_sam\" -> \"\", \"sam\" -> \"\"\n}]\ntakeFileName[f_String] := \
takeFileName[File[f]]\n\nsortFiles[list_List] := With[{\n  names = \
FileBaseName[takeFileName[#]] & /@ list\n},\n  If[Length[list] > 1,\n    \
list[[sorter[names]]]\n  ,\n    list\n  ]\n]\n\nfittingPipeline = \
AsyncFunction[{notebook, path, files}, Module[{\n  process, result, \
choise\n},\n\n    process = fittingLoader[files, path];\n    \
process[\"Progress\"] = 0.5;\n\n    CellPrint[windowContainer[process, Null], \
\"Display\" -> \"wlx\", \"Notebook\" -> notebook, \"Target\" -> _, ImageSize \
-> {1280, 960}];\n    \n    result = process[\"Promise\"] // Await;\n\n    \
process[\"File\"] = .;\n    Delete[process];\n\n    choise = \
ChoiceDialogAsync[\"Save the data?\", \"Notebook\"->notebook] // Await;\n    \
\n    If[choise,\n      result[\"Files\"]\n    ,\n      False\n    \
]\n]];\n\nconvertPipeline = AsyncFunction[{notebook, files}, Module[{process, \
result, choise},\n    process = fileConvertLoader[files];\n    \n    \
If[process === False,\n      MessageDialog[\"No relevant files were found\", \
\"Notebook\"->notebook];\n      Return[False, Module];\n    ];\n    \n    \
process[\"Progress\"] = 0.2;\n\n    CellPrint[windowContainer[process, Null], \
\"Display\" -> \"wlx\", \"Notebook\" -> notebook, \"Target\" -> _, ImageSize \
-> {1.5 526,  1.1 651/1.5}];\n    \n    result = process[\"Promise\"] // \
Await;\n\n    process[\"Files\"] = .;\n    Delete[process];\n      \n    \
process = fileConvertImporter[result[\"Files\"]];\n    process[\"Progress\"] \
= 0.4;\n\n    CellPrint[windowContainer[process, Null], \"Display\" -> \
\"wlx\", \"Target\" -> _, \"Notebook\" -> notebook, ImageSize -> {1.3 526 \
1.2,  651 1.15}];\n\n    result = process[\"Promise\"] // Await;\n    \
process[\"Files\"] = .;\n    Delete[process];\n    \
result[\"Files\"]\n]];\n\nmainPipeline = AsyncFunction[{notebook, files}, \
Module[{process, result, choise},\n\n    process = fileLoader[files];\n    \
process[\"Progress\"] = 0.2;\n\n    CellPrint[windowContainer[process, Null], \
\"Display\" -> \"wlx\", \"Notebook\" -> notebook, \"Target\" -> _, ImageSize \
-> {1.5 526,  1.1 651/1.5}];\n    \n    result = process[\"Promise\"] // \
Await;\n\n    process[\"Files\"] = .;\n    Delete[process];\n      \n    \
process = fileImporter[result[\"Files\"]];\n    process[\"Progress\"] = \
0.4;\n\n    CellPrint[windowContainer[process, Null], \"Display\" -> \"wlx\", \
\"Target\" -> _, \"Notebook\" -> notebook, ImageSize -> {1.3 526 1.2,  651 \
1.20}];\n\n    result = process[\"Promise\"] // Await;\n    \
process[\"Files\"] = .;\n    Delete[process];\n\n    choise = \
ChoiceDialogAsync[\"Perform phase unwrapping\", \"Notebook\"->notebook] // \
Await;\n\n    If[choise,\n      process = phaseUnwrap[result[\"Files\"]]; \n  \
    process[\"Progress\"] = 0.7;\n\n      CellPrint[windowContainer[process, \
Null], \"Display\" -> \"wlx\", \"Target\" -> _, \"Notebook\" -> notebook, \
ImageSize -> {1.3 526 1.2, 1.3 651 / 1.2}];\n\n      result = \
process[\"Promise\"] // Await;\n      process[\"Files\"] = .;\n      \
Delete[process]; \n\n      choise = ChoiceDialogAsync[\"Apply high-accuracy \
material parameters extraction procedure\", \"Notebook\"->notebook] // \
Await;\n\n      If[choise,\n        process = \
materialParams[result[\"Files\"]];\n        process[\"Progress\"] = 0.85;\n   \
     \n        CellPrint[windowContainer[process, Null], \"Display\" -> \
\"wlx\", \"Target\" -> _, \"Notebook\" -> notebook, ImageSize -> {1.3 526 \
1.5, 1.3 651 / 1.1}];\n        \n        result = process[\"Promise\"] // \
Await;\n        process[\"Files\"] = .;\n        Delete[process];        \n   \
   ];\n      \n    ];\n\n    sortFiles[result[\"Files\"]]\n\n]];", 
    "Display" -> "codemirror", "Hash" -> 
     "19caf419-c8cb-42ad-b65b-4fcfd99a0fd1", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"InitGroup" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "3ca0eec5-8545-4744-b1ac-84a5c7706522"|>, 
   <|"Data" -> ".md\n## Supplimentary pipleline\nUsed for loading folders", 
    "Display" -> "codemirror", "Hash" -> 
     "9f17bb55-123f-4a2e-811a-93c27df56780", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"Hidden" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "3ca0eec5-8545-4744-b1ac-84a5c7706522"|>, 
   <|"Data" -> "## Supplimentary pipleline\nUsed for loading folders", 
    "Display" -> "markdown", "Hash" -> 
     "a412c293-4e4f-44be-9466-2c370bc7dabf", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Output", "UID" -> Null, 
    "Notebook" -> "3ca0eec5-8545-4744-b1ac-84a5c7706522"|>, 
   <|"Data" -> "convertAllToFiles[File[f_]] := f;\nconvertAllToFiles[any_] := \
FileNameTake /@ (any[\"Tags\"][\"Filename\"]);\nconvertAllToFiles[files_List, \
path_String] := Map[FileNameJoin[{path, #}]&, convertAllToFiles /@ files // \
Flatten];\n\ngarbageTemp = {};\n\n\nopenFolder[notebook_, path_String] := \
With[{promise = Promise[]}, Module[{session = {}, garbageCollector},\n\n      \
AppendTo[garbageTemp, Hold[session]];\n      ClearAttributes[session, \
Temporary];\n      \n      If[FileExistsQ[FileNameJoin[{path, \
\".TK_Store\"}]],\n        session = Import[FileNameJoin[{path, \
\".TK_Store\"}], \"WXF\"];\n      ];\n\n      session = With[{files = \
FileNames[\"*.csv\" | \"*.dat\" | \"*.tsv\", path]},\n        Join[session, \
File /@ Select[FileNameTake /@ files, Function[name,\n          \
With[{filename = name},\n            With[{checks = Table[\n              {\n \
               filename === i[\"Tags\"][\"Filename\"][[1]],\n                \
filename === i[\"Tags\"][\"Filename\"][[2]]\n              }\n            , \
{i, session}] // Flatten},\n              If[Length[checks] == 0,\n           \
     True,\n                (Or @@ checks) // Not\n              ]\n          \
  ]\n          ]\n        ]] ]\n      ];\n\n\n      \
CellPrint[resultsTable[sortFiles[session], <|\"Fitting\" -> Function[files, \
With[{win = CurrentWindow[]},\n            garbageCollector;\n\n            \
If[AnyTrue[files, MatchQ[#, _File]&],\n              FrontSubmit[Alert[\"Not \
possible to fit unprocessed files\"]];\n              Return[];\n            \
];\n\n            If[Length[files] > 1,\n              \
FrontSubmit[Alert[\"Select only one item\"]];\n              Return[];\n      \
      ];\n            \n            Then[fittingPipeline[notebook, path, \
