   <|"Data" -> "Promise[\"92954415-4e76-49eb-a62b-0407a54372ce\"]", 
    "Display" -> "codemirror", "Hash" -> 
     "4a0e68f7-e392-41ec-bf60-233ee33cecd9", "Invisible" -> False, 
