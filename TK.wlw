.md
## App logic
Combine all together to make an app.

<br/>

### Data processing pipeline
From importing files, processing phase, material parameters to giving the results back

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## App logic
Combine all together to make an app.

<br />

### Data processing pipeline
From importing files, processing phase, material parameters to giving the results back

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
takeFileName[f_] := takeFileName[File[ToLowerCase[f["Tags"]["Filename"][[1]]]]]
takeFileName[File[f_]] := StringReplace[ToLowerCase[f], {
  "_reference_" -> "_", "_reference" -> "", 
  "_ref" -> "", "ref_" -> "", 
  "_hole" -> "", "hole_" -> "", 
  "_sample" -> "", "sample" -> "",
  "_sam" -> "", "sam" -> ""
}]
takeFileName[f_String] := takeFileName[File[f]]

sortFiles[list_List] := With[{
  names = FileBaseName[takeFileName[#]] & /@ list
},
  If[Length[list] > 1,
    list[[sorter[names]]]
  ,
    list
  ]
]

fittingPipeline = AsyncFunction[{notebook, path, files}, Module[{
  process, result, choise
},

    process = fittingLoader[files, path];
    process["Progress"] = 0.5;

    CellPrint[windowContainer[process, Null], "Display" -> "wlx", "Notebook" -> notebook, "Target" -> _, ImageSize -> {1280, 960}];
    
    result = process["Promise"] // Await;

    process["File"] = .;
    Delete[process];

    choise = ChoiceDialogAsync["Save the data?", "Notebook"->notebook] // Await;
    
    If[choise,
      result["Files"]
    ,
      False
    ]
]];

convertPipeline = AsyncFunction[{notebook, files}, Module[{process, result, choise},
    process = fileConvertLoader[files];
    
    If[process === False,
      MessageDialog["No relevant files were found", "Notebook"->notebook];
      Return[False, Module];
    ];
    
    process["Progress"] = 0.2;

    CellPrint[windowContainer[process, Null], "Display" -> "wlx", "Notebook" -> notebook, "Target" -> _, ImageSize -> {1.5 526,  1.1 651/1.5}];
    
    result = process["Promise"] // Await;

    process["Files"] = .;
    Delete[process];
      
    process = fileConvertImporter[result["Files"]];
    process["Progress"] = 0.4;

    CellPrint[windowContainer[process, Null], "Display" -> "wlx", "Target" -> _, "Notebook" -> notebook, ImageSize -> {1.3 526 1.2,  651 1.15}];

    result = process["Promise"] // Await;
    process["Files"] = .;
    Delete[process];
    result["Files"]
]];

mainPipeline = AsyncFunction[{notebook, files}, Module[{process, result, choise},

    process = fileLoader[files];
    process["Progress"] = 0.2;

    CellPrint[windowContainer[process, Null], "Display" -> "wlx", "Notebook" -> notebook, "Target" -> _, ImageSize -> {1.5 526,  1.1 651/1.5}];
    
    result = process["Promise"] // Await;

    process["Files"] = .;
    Delete[process];
      
    process = fileImporter[result["Files"]];
    process["Progress"] = 0.4;

    CellPrint[windowContainer[process, Null], "Display" -> "wlx", "Target" -> _, "Notebook" -> notebook, ImageSize -> {1.3 526 1.2,  651 1.20}];

    result = process["Promise"] // Await;
    process["Files"] = .;
    Delete[process];

    choise = ChoiceDialogAsync["Perform phase unwrapping", "Notebook"->notebook] // Await;

    If[choise,
      process = phaseUnwrap[result["Files"]]; 
      process["Progress"] = 0.7;

      CellPrint[windowContainer[process, Null], "Display" -> "wlx", "Target" -> _, "Notebook" -> notebook, ImageSize -> {1.3 526 1.2, 1.3 651 / 1.2}];

      result = process["Promise"] // Await;
      process["Files"] = .;
      Delete[process]; 

      choise = ChoiceDialogAsync["Apply high-accuracy material parameters extraction procedure", "Notebook"->notebook] // Await;

      If[choise,
        process = materialParams[result["Files"]];
        process["Progress"] = 0.85;
        
        CellPrint[windowContainer[process, Null], "Display" -> "wlx", "Target" -> _, "Notebook" -> notebook, ImageSize -> {1.3 526 1.5, 1.3 651 / 1.1}];
        
        result = process["Promise"] // Await;
        process["Files"] = .;
        Delete[process];        
      ];
      
    ];

    sortFiles[result["Files"]]

]];

