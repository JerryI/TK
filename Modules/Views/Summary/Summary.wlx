exporter["Fitting", {__}] := Null;
views["Fitting", {__}] := Null;

views["Fitting", {t_TransmissionObject | t_MaterialParameters}] := If[KeyExistsQ[t["Tags"], "Fitting"],
    With[{
        P2 = With[{data = t["Tags"]["Fitting"]["State"]},
            Map[<|"ω0 (1/cm)" -> #[[2]], "Strength (1/cm²)" -> #[[1]], "γ (1/cm)" -> #[[3]]|>&, data]
        ] // Dataset,
        Eq = CellView[StringJoin["n(\\omega) = \\sqrt{", ToString[t["Tags"]["Fitting"]["Env"]["\[Epsilon]"]], " + \\sum \\frac{S}{\\Omega_0^2 - \\omega^2 + i \\Gamma \\omega}}"], "Display"->"latex"]
    },
        <div class="flex flex-col gap-y-2">
            <Eq/>
            <P2/>
        </div>
    ]
,
    Null
]

exporter["Fitting", {t_}] := With[{p = t["Tags"]["Fitting"], cached = fitting`generate[t, terakitchen`$sessionViewId] },
    Then[SystemDialogInputAsync["FileSave", {Null, {"Text" -> {"*.txt"}, "JSON" -> {"*.json"}}}], Function[path,
        If[StringQ[path],
            Export[path, p];
            Export[FileNameJoin[{DirectoryName[path], StringJoin[FileBaseName[path], "_absorption.dat"]}], QuantityMagnitude[cached["\[Alpha]"], {1,1}/"Centimeters"] ];
        ]
    ]];    
]


